# Copy to .env and adjust local paths and credentials (docs/environment.md section 4).
CARDIOAI_DATA_ROOT=data/raw/ptb-xl-1.0.3
CARDIOAI_DEVICE=auto
CARDIOAI_LOG_LEVEL=INFO

# Leave empty for local tracking without authentication.
MLFLOW_TRACKING_URI=
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=

# Set to 1 on macOS if a required operation needs the CPU fallback.
PYTORCH_ENABLE_MPS_FALLBACK=
# Set to :4096:8 for deterministic training on CUDA.
CUBLAS_WORKSPACE_CONFIG=
# Keep empty; 1 is reserved exclusively for the final T801 procedure.
CARDIOAI_ALLOW_TEST=

CARDIOAI_PREDICTOR=auto
CARDIOAI_BUNDLE_PATH=models/bundles/current
CARDIOAI_MAX_UPLOAD_MB=10
CARDIOAI_TIMEOUT_S=30
CARDIOAI_DEMO_DIR=api/demo
CARDIOAI_CORS_ORIGINS='["http://localhost:5173"]'
